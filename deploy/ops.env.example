# Copy to /etc/cloudledger/ops.env and chmod 0600. Values are deployment secrets.
CLOUDLEDGER_GHCR_OWNER=owner
CLOUDLEDGER_SERVER_IMAGE=ghcr.io/owner/cloudledger-server:v0.1.5
CLOUDLEDGER_POSTGRES_IMAGE=ghcr.io/owner/cloudledger-postgres:v0.1.5
CLOUDLEDGER_CADDY_IMAGE=ghcr.io/owner/cloudledger-caddy:v0.1.5
CLOUDLEDGER_ANCHOR_IMAGE=ghcr.io/owner/cloudledger-network-anchor:v0.1.5
CLOUDLEDGER_RELEASE_TAG=v0.1.5
CLOUDLEDGER_CLIENT_VERSION=0.1.5
CLOUDLEDGER_MIN_SUPPORTED_CLIENT_VERSION=0.1.5
CLOUDLEDGER_CLIENT_DOWNLOAD_URL=https://github.com/dahai9/CloudLedger/releases/latest
CLOUDLEDGER_API_DOMAIN=api.example.com
CLOUDLEDGER_HTTP_PUBLISH=127.0.0.1:18080:80
CLOUDLEDGER_HTTPS_PUBLISH=443:443
CLOUDLEDGER_CADDY_ORIGIN_CERT_PATH=/etc/cloudledger/caddy/origin-cert.pem
CLOUDLEDGER_CADDY_ORIGIN_KEY_PATH=/etc/cloudledger/caddy/origin-key.pem
CLOUDLEDGER_BOOTSTRAP_DB_PASSWORD=replace-with-a-random-secret
CLOUDLEDGER_MIGRATION_DB_PASSWORD=replace-with-a-random-secret
CLOUDLEDGER_RUNTIME_DB_PASSWORD=replace-with-a-random-secret
CLOUDLEDGER_BOOTSTRAP_DATABASE_URL=postgres://cloudledger_bootstrap:replace-with-a-random-secret@127.0.0.1:5432/cloudledger
CLOUDLEDGER_MIGRATION_DATABASE_URL=postgres://cloudledger_migration:replace-with-a-random-secret@127.0.0.1:5432/cloudledger
CLOUDLEDGER_ADMIN_PATH=manage-replace-with-a-random-path
CLOUDLEDGER_ADMIN_TOKEN=replace-with-32-plus-random-admin-token
CLOUDLEDGER_AUDIT_KEY_ID=audit-random-key-id
CLOUDLEDGER_AUDIT_HMAC_KEY=replace-with-32-plus-random-characters
CLOUDLEDGER_AUDIT_IDENTIFIER_HMAC_KEY=replace-with-32-plus-random-characters
CLOUDLEDGER_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
CLOUDLEDGER_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
CLOUDLEDGER_BACKUP_RETENTION=30
CLOUDLEDGER_MAX_BACKUP_BYTES=53687091200
CLOUDLEDGER_REMOTE_BACKUP_MAX_AGE_HOURS=72
CLOUDLEDGER_RCLONE_REMOTE=cloudledger-crypt:CloudLedger/backups
CLOUDLEDGER_DISK_WARN=80
CLOUDLEDGER_DISK_CRITICAL=90
CLOUDLEDGER_MEMORY_WARN=85
CLOUDLEDGER_CLOUDFLARE_IPV4_URL=https://www.cloudflare.com/ips-v4
CLOUDLEDGER_CLOUDFLARE_IPV6_URL=https://www.cloudflare.com/ips-v6
