{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudLedger",
  "version": "0.1.0",
  "identifier": "com.cloudledger.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloudLedger",
        "label": "main",
        "width": 420,
        "height": 860,
        "minWidth": 360,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "android": {
      "minSdkVersion": 24
    }
  }
}
