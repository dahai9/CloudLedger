{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudLedger",
  "version": "0.1.10",
  "identifier": "com.cloudledger.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloudLedger",
        "label": "main",
        "width": 420,
        "height": 860,
        "minWidth": 360,
        "minHeight": 720,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; connect-src 'self' https: http://127.0.0.1:*; font-src 'self'; form-action 'none'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data:; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
